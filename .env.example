# VibeDigest Environment Configuration Template
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# --- Local Development Overrides ---
NEXT_PUBLIC_API_URL=http://localhost:16081
BACKEND_API_URL=http://localhost:16081
# Production only: Vercel server-side routes should use the Railway origin.
# Keep BACKEND_API_URL as the canonical public API URL in production.
# BACKEND_ORIGIN_URL=https://vibedigest-production.up.railway.app
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=DEBUG
# Optional for isolated developer experiments only; production startup rejects it.
DEV_AUTH_BYPASS=false

# --- Text LLM Routing ---
# Production/API runtime: select openai, openrouter, or custom. If unset, the
# legacy fallback remains custom when OPENAI_BASE_URL is present, otherwise OpenRouter.
# LLM_RUNTIME=api
# LLM_PROVIDER=openai            # Uses GPT-5.6 Luna for every text task
# LLM_PROVIDER=openrouter        # Uses OpenRouter's OpenAI GPT-5.6 Luna route
# LLM_PROVIDER=custom            # Uses GPT-5.6 Luna through an OpenAI-compatible endpoint
#
# Trusted machines only: `make dev` and `make start-frontend` default the local
# Next.js follow-up route to Codex when LLM_RUNTIME is unset. Set
# LLM_RUNTIME=api plus an explicit LLM_PROVIDER to test hosted routing locally.
# Never set codex_local on Railway/Vercel or in CI.
# LLM_RUNTIME=codex_local
# CODEX_LOCAL_TIMEOUT_SECONDS=120
# CODEX_LOCAL_MAX_CONCURRENCY=1
# CODEX_LOCAL_BINARY=             # Optional explicit Codex executable
# CODEX_LOCAL_WORKDIR=            # Optional isolated working directory
# MODEL_ALIAS_SMART=        # Optional smart model override for the active provider
# MODEL_ALIAS_FAST=         # Optional fast model override for the active provider
# OPENAI_API_KEY=           # Required for openai/custom API runtime
# OPENAI_BASE_URL=          # Optional OpenAI-compatible endpoint, usually ending in /v1
# OPENROUTER_BASE_URL=      # Optional OpenRouter endpoint override
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
# OPENAI_AUDIO_API_KEY=     # Optional dedicated transcription key
# OPENAI_AUDIO_BASE_URL=    # Optional dedicated transcription endpoint

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# SUPABASE_JWT_SECRET=       # Optional legacy HS256 fallback; JWKS uses SUPABASE_URL
DATABASE_URL=postgresql://postgres:your-password@your-host:6543/postgres
# VIBEDIGEST_DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# --- Durable Worker Routing ---
# Hosted product worker (Railway):
# WORKER_PROFILE=hosted_api
# TASK_QUEUE_NAME=video_processing
# Trusted catalog worker (private runner; process_catalog_supply.py forces profile/runtime):
# PODCAST_TASK_QUEUE_NAME=podcast_supply
# PODCAST_MAX_JOBS_PER_RUN=4

# --- Task Agent continuation ---
# Production: provision the same random secret (32+ chars) in Vercel and Railway
# API/worker. It is a server-only credential, never NEXT_PUBLIC_*.
# AGENT_INTERNAL_SECRET=
# AGENT_CONTINUATION_URL=https://your-frontend.example/api/internal/agent/continue
# AGENT_CONTINUATION_RUNTIME=api
# AGENT_CONTINUATION_QUEUE=agent_answers
# `make dev` provisions a gitignored 0600 .agent-service-key, a workspace queue,
# and the Docker-to-Next callback automatically. Restart through `make dev` after
# changing the frontend port or runtime; `make start-frontend` alone cannot update
# an already-running backend/worker's callback configuration.

# --- Payment (Optional) ---
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# COINBASE_API_KEY=
# COINBASE_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email (Optional) ---
# RESEND_API_KEY=

# --- Transcript Acceleration (Optional) ---
# SUPADATA_API_KEY=                 # Single key or comma-separated for round-robin rotation: key1,key2,key3

# --- yt-dlp Cookies (Optional) ---
# YTDLP_COOKIES=/app/yt-cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_PROFILE=Default

# --- Observability (Optional) ---
# Enable tracing only when the LangSmith key and project are valid for this environment.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=VibeDigest
# LANGSMITH_PROJECT=VibeDigest
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
