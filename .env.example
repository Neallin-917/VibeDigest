# VibeDigest Environment Configuration Template
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# --- Local Development Overrides ---
NEXT_PUBLIC_API_URL=http://localhost:16081
BACKEND_API_URL=http://localhost:16081
# Production only: Vercel server-side routes should use the Railway origin.
# Keep BACKEND_API_URL as the canonical public API URL in production.
# BACKEND_ORIGIN_URL=https://vibedigest-production.up.railway.app
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=DEBUG
# Optional for isolated developer experiments only; production startup rejects it.
DEV_AUTH_BYPASS=false

# --- Text LLM Routing ---
# Production/API runtime: select openai, openrouter, or custom. If unset, the
# legacy fallback remains custom when OPENAI_BASE_URL is present, otherwise OpenRouter.
# LLM_RUNTIME=api
# LLM_PROVIDER=openai            # Uses the official OpenAI API and GPT-5.6 defaults
# LLM_PROVIDER=openrouter
# LLM_PROVIDER=custom            # Uses OPENAI_BASE_URL as an OpenAI-compatible endpoint
#
# Trusted local development only: use the local Codex app-server and the
# existing `codex login` session. Never set this on Railway/Vercel or in CI.
# LLM_RUNTIME=codex_local
# CODEX_LOCAL_TIMEOUT_SECONDS=120
# CODEX_LOCAL_MAX_CONCURRENCY=1
# CODEX_LOCAL_BINARY=             # Optional explicit Codex executable
# CODEX_LOCAL_WORKDIR=            # Optional isolated working directory
# MODEL_ALIAS_SMART=        # Optional smart model override for the active provider
# MODEL_ALIAS_FAST=         # Optional fast model override for the active provider
# OPENAI_API_KEY=           # Required for openai/custom API runtime
# OPENAI_BASE_URL=          # Optional OpenAI-compatible endpoint, usually ending in /v1
# OPENROUTER_BASE_URL=      # Optional OpenRouter endpoint override
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
# OPENAI_AUDIO_API_KEY=     # Optional dedicated transcription key
# OPENAI_AUDIO_BASE_URL=    # Optional dedicated transcription endpoint

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres:your-password@your-host:6543/postgres
# VIBEDIGEST_DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# --- Payment (Optional) ---
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# COINBASE_API_KEY=
# COINBASE_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email (Optional) ---
# RESEND_API_KEY=

# --- Transcript Acceleration (Optional) ---
# SUPADATA_API_KEY=                 # Single key or comma-separated for round-robin rotation: key1,key2,key3

# --- yt-dlp Cookies (Optional) ---
# YTDLP_COOKIES=/app/yt-cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_PROFILE=Default

# --- Observability (Optional) ---
# Enable tracing only when the LangSmith key and project are valid for this environment.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=VibeDigest
# LANGSMITH_PROJECT=VibeDigest
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
