FROM langchain/langgraph-api:3.11

# Install dependencies
# Layer 1: Heavy Core Dependencies (includes supabase, etc.)
COPY backend/requirements.core.txt /tmp/requirements.core.txt
RUN pip install --no-cache-dir -r /tmp/requirements.core.txt

# Layer 2: Frequent Updates
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /deps/backend
COPY config/llm-provider-defaults.json ./llm-provider-defaults.json
COPY backend/langgraph.json .
COPY backend/langgraph.json /langgraph.json
